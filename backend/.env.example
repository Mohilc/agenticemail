# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/emailai

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# AI Provider (Google Gemini - free tier)
# Get your free API key from: https://aistudio.google.com/apikey
OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash

# Secondary Agent (also using Gemini)
DEEPSEEK_API_KEY=your_gemini_api_key_here
DEEPSEEK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DEEPSEEK_MODEL=gemini-3.6-flash

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

