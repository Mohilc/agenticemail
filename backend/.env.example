# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/emailai

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Primary AI / OpenAI API Key
OPENAI_API_KEY=your_openai_or_nvidia_api_key_here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=deepseek-ai/deepseek-v4-flash-0731

# DeepSeek Agent
DEEPSEEK_API_KEY=your_deepseek_agent_api_key_here
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
